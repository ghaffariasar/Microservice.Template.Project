# Normalize line endings
* text=auto

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Mark common doc types
*.md linguist-documentation
docs/** linguist-documentation

# Improve diffs for common file types
*.cs diff=csharp
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text
*.yml text
*.yaml text


