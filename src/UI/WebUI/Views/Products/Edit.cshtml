@model WebUI.Models.ProductCreateModel
@{
    ViewData["Title"] = "ویرایش محصول";
}

<div class="card">
    <div class="card-header">
        <h4>
            <i class="bi bi-pencil-square me-2"></i>
            ویرایش محصول
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">نام محصول</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">توضیحات</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">قیمت (تومان)</label>
                    <input type="number" name="Price" value="@Model.Price" class="form-control" min="0" step="0.01" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">موجودی کل</label>
                    <input type="number" name="InitialStock" value="@Model.InitialStock" class="form-control" min="0" disabled />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>
                    ذخیره تغییرات
                </button>
                <a href="/Products" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>
                    انصراف
                </a>
            </div>
        </form>
    </div>
</div>


