@{
    ViewData["Title"] = "ایجاد محصول جدید";
}

<div class="card">
    <div class="card-header">
        <h4>
            <i class="bi bi-plus-circle me-2"></i>
            ایجاد محصول جدید
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">نام محصول</label>
                <input type="text" name="Name" class="form-control" required placeholder="نام محصول را وارد کنید" />
            </div>
            <div class="mb-3">
                <label class="form-label">توضیحات</label>
                <textarea name="Description" class="form-control" rows="3" placeholder="توضیحات محصول"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">قیمت (تومان)</label>
                    <input type="number" name="Price" class="form-control" min="0" step="0.01" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">موجودی اولیه</label>
                    <input type="number" name="InitialStock" class="form-control" min="0" required />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>
                    ایجاد محصول
                </button>
                <a href="/Products" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>
                    انصراف
                </a>
            </div>
        </form>
    </div>
</div>

