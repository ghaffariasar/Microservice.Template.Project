@{
    ViewData["Title"] = "ایجاد سفارش جدید";
}

<div class="card">
    <div class="card-header">
        <h4>
            <i class="bi bi-plus-circle me-2"></i>
            ایجاد سفارش جدید
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">شناسه مشتری</label>
                <input type="text" name="CustomerId" class="form-control" required placeholder="شناسه مشتری را وارد کنید" />
            </div>
            <div class="mb-3">
                <label class="form-label">محصولات</label>
                <div id="items-container">
                    <div class="item-row mb-3 p-3 border rounded">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">محصول</label>
                                <select class="form-select product-select" name="Items[0].ProductId" required>
                                    <option value="">یک محصول را انتخاب کنید</option>
                                    @if (ViewBag.Products != null)
                                    {
                                        foreach (var p in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products)
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" name="Items[0].ProductName" class="product-name-hidden" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">تعداد</label>
                                <input type="number" name="Items[0].Quantity" class="form-control" min="1" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">قیمت</label>
                                <input type="number" name="Items[0].UnitPrice" class="form-control" min="0" step="0.01" required />
                            </div>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addItem()">
                    <i class="bi bi-plus me-1"></i>
                    افزودن محصول
                </button>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>
                    ایجاد سفارش
                </button>
                <a href="/Orders" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>
                    انصراف
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    const products = JSON.parse('@Html.Raw(ViewBag.ProductsJson ?? "[]")');
    let itemIndex = 1;
    function addItem() {
        const container = document.getElementById('items-container');
        const newRow = document.createElement('div');
        newRow.className = 'item-row mb-3 p-3 border rounded';
        newRow.innerHTML = `
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">محصول</label>
                    <select class="form-select product-select" name="Items[${itemIndex}].ProductId" required>
                        <option value="">یک محصول را انتخاب کنید</option>
                        ${products.map(p => `<option value="${p.id}">${p.name}</option>`).join('')}
                    </select>
                    <input type="hidden" name="Items[${itemIndex}].ProductName" class="product-name-hidden" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">تعداد</label>
                    <input type="number" name="Items[${itemIndex}].Quantity" class="form-control" min="1" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">قیمت</label>
                    <input type="number" name="Items[${itemIndex}].UnitPrice" class="form-control" min="0" step="0.01" required />
                </div>
            </div>
        `;
        container.appendChild(newRow);
        wireUpSelect(newRow);
        itemIndex++;
    }

    function wireUpSelect(scope) {
        (scope || document).querySelectorAll('.product-select').forEach(sel => {
            sel.addEventListener('change', function () {
                const selected = products.find(p => p.id === this.value);
                const hidden = this.parentElement.querySelector('.product-name-hidden');
                if (hidden) hidden.value = selected ? selected.name : '';
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        wireUpSelect();
    });
</script>

